{
  "name": "SPEED CHESS — Play. Learn. Compete.",
  "short_name": "SPEED CHESS",
  "description": "Play speed chess online, work through a complete beginner academy, solve puzzles, and compete in tournaments.",
  "id": "/",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "background_color": "#0B0B0D",
  "theme_color": "#090909",
  "categories": ["games", "education", "entertainment"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Play a game", "short_name": "Play", "url": "/play", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Daily puzzle", "short_name": "Puzzles", "url": "/training", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Learn chess", "short_name": "Learn", "url": "/learn", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
