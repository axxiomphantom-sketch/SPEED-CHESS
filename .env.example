# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
DATA_DIR=./data

# Set explicitly in production: openssl rand -hex 48
# JWT_SECRET=
SESSION_TTL_DAYS=30
TRUST_PROXY=1

# Optional integrations. Without these the API reports the feature as pending
# instead of pretending to work.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM=no-reply@example.com

# ---------------------------------------------------------------------------
# Supabase authentication (optional but recommended)
# ---------------------------------------------------------------------------
# The publishable/anon key is public: it ships to the browser and is guarded by
# Row Level Security. NEVER put a service-role key here.
# The API reads the VITE_ names automatically; the non-prefixed names win if set.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=

# Require verified email before entering protected areas (default: permissive locally).
# EMAIL_VERIFICATION_REQUIRED=true
