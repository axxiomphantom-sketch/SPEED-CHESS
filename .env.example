# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
DATA_DIR=./data

# Set explicitly in production: openssl rand -hex 48
# JWT_SECRET=
SESSION_TTL_DAYS=30
TRUST_PROXY=1

# Optional integrations. Without these the API reports the feature as pending
# instead of pretending to work.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM=no-reply@example.com

# ---------------------------------------------------------------------------
# Supabase authentication (optional but recommended)
# ---------------------------------------------------------------------------
# The publishable/anon key is public: it ships to the browser and is guarded by
# Row Level Security. NEVER put a service-role key here.
#
# This is a Vite project, so the frontend reads the VITE_ names (NEXT_PUBLIC_* does nothing here).
# The API prefers the non-prefixed names and falls back to the VITE_ pair, so filling in the two
# VITE_ values below is enough to configure both halves.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional server-side overrides (win over the VITE_ values when set):
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=

# Require verified email before entering protected areas (default: permissive locally).
# EMAIL_VERIFICATION_REQUIRED=true
